<script>
  (function () {
    var tocRoot = document.querySelector(".sidebar .toc-container");
    var main = document.querySelector("main.content");
    if (!tocRoot || !main) return;

    var links = Array.prototype.slice.call(tocRoot.querySelectorAll('a[href^="#"]'));
    if (!links.length) return;

    var items = [];
    links.forEach(function (link) {
      var href = link.getAttribute("href") || "";
      if (href.length < 2) return;
      var id;
      try {
        id = decodeURIComponent(href.slice(1));
      } catch (e) {
        id = href.slice(1);
      }
      if (!id) return;
      var heading = main.querySelector("#" + CSS.escape(id));
      if (!heading) heading = document.getElementById(id);
      if (!heading || !main.contains(heading)) return;
      items.push({ link: link, heading: heading });
    });
    if (!items.length) return;

    var activeLink = null;
    var paused = false;

    new MutationObserver(function () {
      paused = document.body.classList.contains("dg-lightbox-open");
    }).observe(document.body, { attributes: true, attributeFilter: ["class"] });

    function scrollTocToLink(link) {
      var linkRect = link.getBoundingClientRect();
      var containerRect = tocRoot.getBoundingClientRect();
      var offset = linkRect.top - containerRect.top + tocRoot.scrollTop;
      var target = offset - tocRoot.clientHeight / 2 + link.offsetHeight / 2;
      var maxScroll = Math.max(0, tocRoot.scrollHeight - tocRoot.clientHeight);
      tocRoot.scrollTop = Math.max(0, Math.min(target, maxScroll));
    }

    function setActive(next) {
      if (paused || activeLink === next) return;
      if (activeLink) activeLink.classList.remove("is-active");
      activeLink = next;
      if (activeLink) {
        activeLink.classList.add("is-active");
        scrollTocToLink(activeLink);
      }
    }

    function pickActive() {
      if (paused) return;
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 48) {
        setActive(items[items.length - 1].link);
        return;
      }

      var bandTop = 96;
      var bandBottom = Math.max(bandTop + 80, window.innerHeight * 0.42);
      var current = items[0];
      var inBand = null;
      var inBandTop = Infinity;

      for (var i = 0; i < items.length; i++) {
        var rect = items[i].heading.getBoundingClientRect();
        if (rect.top >= bandTop && rect.top <= bandBottom && rect.top < inBandTop) {
          inBand = items[i];
          inBandTop = rect.top;
        }
      }

      if (inBand) {
        current = inBand;
      } else {
        for (var j = 0; j < items.length; j++) {
          if (items[j].heading.getBoundingClientRect().top <= bandTop) {
            current = items[j];
          }
        }
      }

      setActive(current.link);
    }

    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        pickActive();
        ticking = false;
      });
    }

    if ("IntersectionObserver" in window) {
      var visible = new Map();
      var observer = new IntersectionObserver(
        function (entries) {
          if (paused) return;
          entries.forEach(function (entry) {
            if (entry.isIntersecting) visible.set(entry.target, entry.intersectionRatio);
            else visible.delete(entry.target);
          });

          if (visible.size) {
            var best = null;
            var bestTop = Infinity;
            items.forEach(function (item) {
              if (!visible.has(item.heading)) return;
              var top = item.heading.getBoundingClientRect().top;
              if (top < bestTop) {
                bestTop = top;
                best = item;
              }
            });
            if (best) {
              setActive(best.link);
              return;
            }
          }
          pickActive();
        },
        { root: null, rootMargin: "-20% 0px -60% 0px", threshold: [0, 0.1, 0.25, 0.5, 1] }
      );
      items.forEach(function (item) {
        observer.observe(item.heading);
      });
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    pickActive();
  })();
</script>
