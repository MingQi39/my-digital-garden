<div id="dg-reading-progress" class="dg-reading-progress" aria-hidden="true">
  <div class="dg-reading-progress-bar"></div>
</div>
<script>
  (function () {
    var main = document.querySelector("main.content");
    var bar = document.querySelector(".dg-reading-progress-bar");
    var container = document.getElementById("dg-reading-progress");
    if (!main || !bar || !container) return;

    if (main.classList.contains("canvas-page")) {
      container.remove();
      return;
    }

    var ticking = false;
    var geometryRaf = 0;

    function syncGeometry() {
      var rect = main.getBoundingClientRect();
      container.style.left = Math.max(0, rect.left) + "px";
      container.style.width = Math.max(0, rect.width) + "px";
    }

    function getProgress() {
      var total = main.offsetHeight - window.innerHeight;
      if (total <= 0) return 100;
      var scrolled = window.scrollY - main.offsetTop;
      return Math.min(100, Math.max(0, (scrolled / total) * 100));
    }

    function update() {
      syncGeometry();
      if (main.classList.contains("dg-mindmap-mode") && !main.classList.contains("dg-show-raw-content")) {
        bar.style.width = "0%";
        container.style.opacity = "0";
        return;
      }
      container.style.opacity = "1";
      bar.style.width = getProgress() + "%";
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        update();
        ticking = false;
      });
    }

    // 侧栏展开/收起有 0.25s 过渡，期间持续同步进度条几何，避免错位
    function syncDuringLayoutTransition() {
      var start = performance.now();
      if (geometryRaf) cancelAnimationFrame(geometryRaf);
      function frame(now) {
        update();
        if (now - start < 320) {
          geometryRaf = requestAnimationFrame(frame);
        } else {
          geometryRaf = 0;
          update();
        }
      }
      geometryRaf = requestAnimationFrame(frame);
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });

    if (window.ResizeObserver) {
      new ResizeObserver(onScroll).observe(main);
    }

    main.addEventListener("transitionend", function (e) {
      if (e.target !== main) return;
      if (e.propertyName === "margin-left" || e.propertyName === "max-width") {
        update();
      }
    });

    new MutationObserver(function (mutations) {
      for (var i = 0; i < mutations.length; i++) {
        if (mutations[i].attributeName !== "class") continue;
        var before = mutations[i].oldValue || "";
        var collapsedBefore = before.indexOf("filetree-collapsed") !== -1;
        var collapsedAfter = document.body.classList.contains("filetree-collapsed");
        if (collapsedBefore !== collapsedAfter) {
          syncDuringLayoutTransition();
          return;
        }
      }
    }).observe(document.body, {
      attributes: true,
      attributeFilter: ["class"],
      attributeOldValue: true,
    });

    update();
  })();
</script>
